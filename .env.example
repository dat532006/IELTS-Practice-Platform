# ===== Client-safe (browser) =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# W19: domain production cho SEO (metadataBase/robots/sitemap/OG). Không phải secret. Fallback http://localhost:3000 khi chưa set.
NEXT_PUBLIC_SITE_URL=

# ===== 🔐 Server-only — TUYỆT ĐỐI KHÔNG prefix NEXT_PUBLIC_ =====
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# A2: Writing AI có 2 provider — 'anthropic' (Claude) | 'openai' (ChatGPT). Không set WRITING_AI_PROVIDER
#   → tự chọn theo key có sẵn (anthropic ưu tiên). OPENAI_API_KEY server-only như mọi secret.
OPENAI_API_KEY=
WRITING_AI_PROVIDER=
# WRITING_GRADER_OPENAI_MODEL=gpt-4o-mini   # override model OpenAI (mặc định gpt-4o-mini)
ACTIVATION_CODE_PEPPER=
# A1: chế độ cổng thanh toán — 'sandbox' (mặc định, dev/smoke) | 'live' (cổng thật, cần creds dưới)
#   | 'disabled' (chặn nạp — dùng khi chưa có merchant để user thật không gặp redirect chết).
PAYMENT_GATEWAY_MODE=
# VNPay (live): secret HMAC-SHA512 + mã TMN do VNPay cấp sau khi duyệt merchant.
#   VNPAY_URL mặc định sandbox https://sandbox.vnpayment.vn/paymentv2/vpcpay.html — đổi sang URL prod khi live.
VNPAY_SECRET=
VNPAY_TMN_CODE=
# VNPAY_URL=
# MoMo (live): partner creds do MoMo cấp. MOMO_ENDPOINT mặc định sandbox https://test-payment.momo.vn.
MOMO_SECRET=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
# MOMO_ENDPOINT=
# SePay (A1-alt, provider 'bank' — chuyển khoản VietQR, KHÔNG cần merchant): API key auth webhook
#   (SePay dashboard → Webhook → kiểu API Key, header "Authorization: Apikey ..."); TK ngân hàng nhận tiền
#   cho VietQR (qr.sepay.vn). Đủ 3 biến đầu + PAYMENT_GATEWAY_MODE=live → chip "Chuyển khoản" hoạt động.
SEPAY_API_KEY=
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_CODE=
# SEPAY_ACCOUNT_NAME=
# W15: secret để verify chữ ký webhook topup (sandbox HMAC — route này TỰ TẮT khi PAYMENT_GATEWAY_MODE=live).
PAYMENT_WEBHOOK_SECRET=
# W19: bearer token cho Vercel Cron gọi /api/cron/reconcile-topups. Thiếu → route trả 503 (fail-closed).
CRON_SECRET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2 bucket + endpoint cho signed audio URL (W7). Dùng R2_ACCOUNT_ID (dựng endpoint mặc định)
#   HOẶC R2_ENDPOINT (full URL). Thiếu bất kỳ var R2 nào → audio_url=null + warning R2_NOT_CONFIGURED.
R2_BUCKET=
R2_ACCOUNT_ID=
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # tùy chọn — thay cho R2_ACCOUNT_ID
# R2_URL_TTL_SEC=300                                        # TTL signed URL (clamp 60..900)

# W11 Writing AI IP rate limit (server-only). Store only hash, never raw IP. Default daily limit = 20 if unset.
AI_GRADE_IP_DAILY_LIMIT=20
AI_GRADE_IP_RATE_LIMIT_PEPPER=
